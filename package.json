{
  "name": "react-player",
  "version": "3.4.0",
  "description": "A React component for playing a variety of URLs, including file paths, Mux, YouTube, Vimeo, and Wistia",
  "author": "Pete Cook (https://github.com/cookpete)",
  "license": "MIT",
  "homepage": "https://github.com/cookpete/react-player",
  "bugs": {
    "url": "https://github.com/cookpete/react-player/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cookpete/react-player.git"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist demo coverage tsconfig.tsbuildinfo",
    "start": "run-p 'build:esm -- --watch' 'build:demo -- --watch=forever --servedir=demo'",
    "lint": "biome lint src/*",
    "test": "node --import tsx --test test/*.test.tsx test/*/*.test.*",
    "test:coverage": "c8 --src src --exclude 'test/**' --exclude 'node_modules/**' --exclude-after-remap --reporter=text --reporter=lcov npm test",
    "build": "run-s build:*",
    "build:esm": "tsc",
    "prebuild:demo": "rm -rf demo && cp -r examples/react/public demo",
    "build:demo": "esbuild ./examples/react/src/index.tsx --format=esm --splitting --bundle --outdir=demo --minify --target=es2020",
    "preversion": "run-s lint test",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "prepublishOnly": "npm run build",
    "postpublish": "npm run clean"
  },
  "peerDependencies": {
    "@types/react": "^18 || ^19",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "@videojs/dash-video": "^10.0.0",
    "@videojs/hlsjs-video": "^10.0.0",
    "@videojs/mux-video": "^10.0.0",
    "@videojs/react": "^10.0.0",
    "@videojs/spotify-audio": "^10.0.0",
    "@videojs/tiktok-video": "^10.0.0",
    "@videojs/twitch-video": "^10.0.0",
    "@videojs/vimeo-video": "^10.0.0",
    "@videojs/wistia-video": "^10.0.0",
    "@videojs/youtube-video": "^10.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.2",
    "@types/node": "^20.14.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-test-renderer": "^18.3.0",
    "auto-changelog": "^2.0.0",
    "c8": "^8.0.1",
    "esbuild": "~0.28.0",
    "npm-run-all": "^4.1.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "screenfull": "^5.0.2",
    "sinon": "^16.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5",
    "zora": "^5.2.0"
  },
  "auto-changelog": {
    "breakingPattern": "Breaking changes:"
  },
  "sideEffects": [
    "./test/**/*"
  ],
  "keywords": [
    "react",
    "media",
    "player",
    "video",
    "audio",
    "youtube",
    "vimeo",
    "wistia",
    "hls",
    "dash",
    "react-component"
  ]
}
