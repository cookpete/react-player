{
  "name": "react-player",
  "version": "3.4.0",
  "description": "A React component for playing a variety of URLs, including file paths, Mux, YouTube, Vimeo, and Wistia",
  "keywords": [
    "audio",
    "dash",
    "hls",
    "media",
    "player",
    "react",
    "react-component",
    "video",
    "vimeo",
    "wistia",
    "youtube"
  ],
  "homepage": "https://github.com/cookpete/react-player",
  "bugs": {
    "url": "https://github.com/cookpete/react-player/issues"
  },
  "license": "MIT",
  "author": "Pete Cook (https://github.com/cookpete)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cookpete/react-player.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./test/**/*"
  ],
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "prepare": "vp config --no-agent",
    "clean": "rimraf dist demo coverage",
    "start": "vp dev examples/react",
    "dev": "vp pack --watch",
    "lint": "vp check --no-lint && vp lint --quiet",
    "lint:fix": "vp check --fix",
    "format": "vp fmt --write",
    "typecheck": "tsgo --noEmit",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage",
    "build": "vp pack",
    "build:demo": "vp build examples/react",
    "codemod:v4": "jscodeshift --extensions=js,jsx,ts,tsx -t codemods/v4.ts",
    "preversion": "pnpm lint && pnpm test",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "prepublishOnly": "pnpm build",
    "postpublish": "pnpm clean"
  },
  "dependencies": {
    "@videojs/dash-video": "^10.0.1",
    "@videojs/hlsjs-video": "^10.0.1",
    "@videojs/mux-video": "^10.0.1",
    "@videojs/react": "^10.0.1",
    "@videojs/spotify-audio": "^10.0.1",
    "@videojs/tiktok-video": "^10.0.1",
    "@videojs/twitch-video": "^10.0.1",
    "@videojs/vimeo-video": "^10.0.1",
    "@videojs/wistia-video": "^10.0.1",
    "@videojs/youtube-video": "^10.0.1"
  },
  "devDependencies": {
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^22.18.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-test-renderer": "^18.3.0",
    "@typescript/native-preview": "beta",
    "@vitest/coverage-v8": "5.0.1",
    "auto-changelog": "^2.0.0",
    "jscodeshift": "^17.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "rimraf": "^6.1.3",
    "screenfull": "^5.0.2",
    "vite-plus": "1.0.0"
  },
  "peerDependencies": {
    "@types/react": "^18 || ^19",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "auto-changelog": {
    "breakingPattern": "Breaking changes:"
  },
  "packageManager": "pnpm@12.6.0"
}
